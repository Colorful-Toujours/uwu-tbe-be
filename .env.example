PORT=8888

# Docker Compose overrides DB_HOST and DB_PORT with the PostgreSQL service.
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=uwu_user
DB_PASSWORD=replace-with-a-long-random-password
DB_DATABASE=uwu_db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# This project does not have migrations yet. Use true for the first boot of an
# empty database, then change it to false and restart the API container.
DB_SYNCHRONIZE=true

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
